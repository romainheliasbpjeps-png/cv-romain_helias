# Application Configuration
APP_NAME="PDF to JSON Converter"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# File Upload
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=uploads
TEMP_DIR=temp

# PDF Processing
DEFAULT_DPI=300
MAX_PAGES=  # Empty = unlimited

# OCR Configuration
TESSERACT_CMD=  # Leave empty for auto-detection
OCR_LANGUAGES=fra,eng,spa,deu,ita,por
DEFAULT_OCR_LANG=fra
OCR_TIMEOUT=300

# Performance
WORKER_COUNT=4
WORKER_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text  # text or json
